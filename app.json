{
  "expo": {
    "name": "RendimientoApp",
    "slug": "RendimientoApp",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecciona una foto para agregarla a un plato del menú.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Restaurante El Sabor",
      "shortName": "El Sabor",
      "output": "single",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/Restaurante_el_sabor"
    }
  }
}